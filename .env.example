MYSQL_ROOT_PASSWORD=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_SECRET

# Nginx 生产入口默认绑定 80 端口，可按需覆盖。
FRONTEND_PORT=80
BACKEND_PORT=8001
MYSQL_PORT=3308
MYSQL_DATABASE=ai_data_analysis

# 浏览器访问 Nginx 的地址；Docker 内部通过同源 /api 代理访问后端。
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# 使用 DeepSeek 时替换占位符；不使用时设置 LLM_PROVIDER=rule_based。
LLM_PROVIDER=rule_based
LLM_API_KEY=CHANGE_ME
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=25
