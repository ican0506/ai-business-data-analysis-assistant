MYSQL_ROOT_PASSWORD=请替换为强数据库密码
JWT_SECRET_KEY=请生成至少32位随机密钥

# Nginx 生产入口默认绑定 80 端口，可按需覆盖。
FRONTEND_PORT=80
BACKEND_PORT=8001
MYSQL_PORT=3308
MYSQL_DATABASE=ai_data_analysis

# 浏览器访问 Nginx 的地址；Docker 内部通过同源 /api 代理访问后端。
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# 使用 DeepSeek 时填写；不使用时保持为空并设置 rule_based。
LLM_PROVIDER=rule_based
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=25
