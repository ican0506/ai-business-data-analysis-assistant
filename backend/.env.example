APP_NAME=AI智能数据分析助手
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_data_analysis
