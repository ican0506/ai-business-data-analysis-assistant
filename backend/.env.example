MYSQL_PASSWORD=请替换为本地MySQL密码

JWT_SECRET_KEY=请生成并替换为随机密钥
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

UPLOAD_MAX_FILE_SIZE_MB=20
STORAGE_ROOT=../storage

LLM_API_KEY=
